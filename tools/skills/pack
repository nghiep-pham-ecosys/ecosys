#!/usr/bin/env python3
"""Pack skills/<name>/ into dist/skills/<name>.zip, ready to upload as Claude skills.

Usage: tools/skills/pack [--skills DIR] [--out DIR] [NAME ...]
Exit 0 on success, 1 on a validation error (nothing is written then), 2 on bad arguments.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _packlib import SkillError, pack_all  # noqa: E402

ROOT = Path(__file__).resolve().parents[2]


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--skills", default=str(ROOT / "skills"), help="skills folder (default: <root>/skills)")
    ap.add_argument("--out", default=str(ROOT / "dist" / "skills"), help="output folder (default: <root>/dist/skills)")
    ap.add_argument("names", nargs="*", help="only these skills (default: all)")
    args = ap.parse_args(argv)
    try:
        packed = pack_all(Path(args.skills), Path(args.out), args.names or None)
    except SkillError as exc:
        print(f"skills pack: {exc}", file=sys.stderr)
        return 1
    for p in packed:
        print(f"{p.name:16} {p.files} file(s) -> {p.path}")
    print(f"skills pack: {len(packed)} zip(s) in {args.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
