#!/usr/bin/env python3
"""Merge a PR only when it is open, ready and green on two reads.

Usage:
  tools/ship/merge <pr-number> [--repo owner/name] [--wait-seconds 20]
                   [--require ci-result,pr-title] [--dry-run]

Exit codes: 0 merged (or dry run passed), 1 refused, 2 usage or gh read
error, 3 the merge command failed or could not be confirmed.
"""

from __future__ import annotations

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import _shiplib  # noqa: E402


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="tools/ship/merge",
        description=(
            "Squash-merge a PR after two reads, some seconds apart, both show it "
            "open, not a draft, free of conflicts and fully green. The merge pins "
            "the head commit with --match-head-commit."
        ),
    )
    parser.add_argument("number", type=int, help="PR number")
    parser.add_argument(
        "--repo", help="owner/name (default: the repo of the current directory)"
    )
    parser.add_argument(
        "--wait-seconds", type=float, default=_shiplib.DEFAULT_WAIT_SECONDS,
        help="seconds between the two reads (default: %(default)g)",
    )
    parser.add_argument(
        "--require", default=",".join(_shiplib.DEFAULT_REQUIRED),
        help="comma-separated checks that must exist and succeed "
             "(default: %(default)s; pass '' for none)",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="run every check, print the merge command, do not merge",
    )
    args = parser.parse_args(argv)
    if args.number <= 0:
        parser.error("pr-number must be positive")
    if args.wait_seconds < 0:
        parser.error("--wait-seconds must be 0 or more")
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    required = [name.strip() for name in args.require.split(",") if name.strip()]
    return _shiplib.merge(
        number=args.number,
        repo=args.repo,
        wait_seconds=args.wait_seconds,
        required=required,
        dry_run=args.dry_run,
    )


if __name__ == "__main__":
    sys.exit(main())
