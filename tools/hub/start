#!/usr/bin/env python3
"""Start the Claude Code hub: a Remote Control server at the workspace root.

Usage:
  tools/hub/start [--no-tmux] [--name NAME] [--permission-mode MODE] [--dry-run]

Runs `claude remote-control --spawn worktree --name hub` from the workspace root, inside the tmux
session `hub` when tmux is installed (a second call reattaches). Open the hub from the Claude app
(Code tab) or claude.ai/code. Keep the machine awake: the hub stops when WSL or the laptop sleeps.
Exit codes: 0 ok (or the exit code of claude/tmux), 1 claude not found, 2 bad arguments.
"""

from __future__ import annotations

import argparse
import os
import shlex
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _hublib as hl  # noqa: E402

ROOT = Path(__file__).resolve().parents[2]


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Start the Claude Code hub (Remote Control).")
    ap.add_argument("--no-tmux", action="store_true", help="run in this terminal, not in tmux")
    ap.add_argument("--name", default=hl.HUB_NAME, help="session name shown in the app")
    ap.add_argument("--permission-mode", help="permission mode for new sessions (default: settings)")
    ap.add_argument("--dry-run", action="store_true", help="print the command and exit")
    args = ap.parse_args(argv)

    cmd = hl.launch_command(
        hl.claude_command(args.name, args.permission_mode),
        use_tmux=not args.no_tmux,
        tmux_found=shutil.which("tmux") is not None,
        inside_tmux=bool(os.environ.get("TMUX")),
    )
    print(f"cd {shlex.quote(str(ROOT))} && {shlex.join(cmd)}")
    if args.dry_run:
        return 0
    if shutil.which("claude") is None:
        print("claude not found on PATH", file=sys.stderr)
        return 1
    os.chdir(ROOT)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    sys.exit(main())
