#!/usr/bin/env python3
"""Print one line per repo: branch, dirty count, ahead/behind, open PRs (spec section 4.5).

Read-only: it does not fetch, so ahead/behind is as of the last fetch
(run `just ws-sync` first for fresh numbers). Open PRs come from
`gh pr list`; with --no-gh, or when gh fails, the column shows "-" or "?".

Repos come from repos.yaml plus, when it exists, the private overlay
private/ops/repos.private.yaml (same schema); the NOTE column marks the
overlay rows "private-manifest". The NOTE column also flags: detached, not <default branch>, no commits, no origin,
upstream gone (the branch tracks a remote branch that no longer exists).

Exit code: 0 normally. With --strict, 1 when any repo is missing, dirty, not
on its default branch, has no commits, has no origin remote or has lost its
upstream (the Phase 0 "Done when" check). 2 on a bad manifest.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import _wslib as ws  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="ws-status", description=__doc__.splitlines()[0])
    parser.add_argument("--no-gh", action="store_true", help="do not call gh for open PR counts")
    parser.add_argument("--strict", action="store_true", help="exit 1 if any repo is missing, dirty, off its default branch, without commits, without origin or with its upstream gone")
    ws.add_manifest_args(parser)
    args = parser.parse_args(argv)

    root, manifest_path, private_path = ws.manifest_paths(args)
    try:
        manifest, _ = ws.load_workspace_manifest(manifest_path, private_path)
    except ws.ManifestError as exc:
        print(f"ws-status: {exc}", file=sys.stderr)
        return 2

    statuses = ws.collect_status(root, manifest, use_gh=not args.no_gh)
    print(ws.format_status_table(statuses), flush=True)

    if args.strict:
        bad = [(st.repo.name, st.problems) for st in statuses if st.problems]
        if bad:
            print("", file=sys.stderr)
            for name, problems in bad:
                print(f"strict: {name}: {', '.join(problems)}", file=sys.stderr)
            return 1
        print("strict: every repo is clean on its default branch", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
